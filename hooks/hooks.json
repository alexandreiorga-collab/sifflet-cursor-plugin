{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-sifflet-destructive.py\" || exit 2",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__sifflet.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-sifflet-destructive.py\" || exit 2",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
